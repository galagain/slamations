FROM dyneomt-torch27-triton33:jp6

ENV FORCE_CUDA=1 \
    TORCH_CUDA_ARCH_LIST=8.7

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential git libglib2.0-0 libgl1 && \
    rm -rf /var/lib/apt/lists/*

RUN uv pip install --system \
      matplotlib==3.10.1 \
      timm==1.0.20 \
      scipy==1.15.2 \
      fvcore==0.1.5.post20221221 \
      pycocotools==2.0.8 \
      tqdm==4.67.1 \
      opencv-python==4.11.0.86 \
      einops==0.8.1 \
      submitit==1.5.2 \
      scikit-image==0.25.2 \
      shapely==2.1.0 \
      h5py==3.13.0 \
      omegaconf==2.3.0 \
      iopath==0.1.9 \
      yacs==0.1.8

RUN uv pip install --system --no-build-isolation \
      'git+https://github.com/facebookresearch/detectron2.git@b599f139756bd3646a26a909caf86a1a159e53a7' && \
    uv pip install --system \
      'git+https://github.com/cocodataset/panopticapi.git'

RUN python3 -c 'import torch, triton, detectron2, cv2, timm; print(torch.__version__, triton.__version__, detectron2.__version__, cv2.__version__, timm.__version__)'
