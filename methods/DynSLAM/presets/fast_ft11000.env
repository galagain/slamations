# DynSLAM fast preset.
# Required binary mask: FT1=1, FT2=1, every other bit disabled.

DYNSLAM_METHOD_NAME=dynslam_ft11000_dyneomt_fast
DYNSLAM_FASTTRACK=1
DYNSLAM_TURBOMAP=0
DYNSLAM_FASTLOOP=0
DYNSLAM_KERNEL_FT=11000
DYNSLAM_KERNEL_TM=0000
DYNSLAM_KERNEL_FL=00000
DYNSLAM_KERNEL_AD=00000

# Semantic side of DynSLAM.
DYNSLAM_SEMANTIC_BACKEND=dyneomt
DYNSLAM_SEMANTIC_STRIDE=16
DYNSLAM_DYNEOMT_COMMAND=/usr/local/bin/dyneomt_predict_mask.sh
