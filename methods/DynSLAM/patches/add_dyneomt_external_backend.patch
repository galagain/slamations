+class DynEOMTExternalBackend : public ISemanticBackend
+{
+public:
+    explicit DynEOMTExternalBackend(const SemanticMaskerConfig &config)
+        : mConfig(config),
+          mCommand(config.dyneomtCommand.empty()
+                       ? std::string("/usr/local/bin/dyneomt_predict_mask.sh")
+                       : config.dyneomtCommand),
+          mWorkDir(config.dyneomtWorkDir.empty()
+                       ? std::string("/tmp/dynslam_dyneomt")
+                       : config.dyneomtWorkDir),
+          mCounter(0)
+    {
+        if(mCommand.empty())
+            throw std::runtime_error("DynEOMT backend requires Semantic.dyneomt_command");
+        mkdir(mWorkDir.c_str(), 0755);
+    }
+
+    void PredictFeatureMask(const cv::Mat &imageBgr, cv::Mat &featureMask) override
+    {
+        if(imageBgr.empty())
+            throw std::runtime_error("DynEOMT backend received an empty image");
+
+        const unsigned long long request = ++mCounter;
+        const std::string prefix = JoinPath(mWorkDir, "frame_" + std::to_string(request));
+        const std::string inputPath = prefix + "_rgb.png";
+        const std::string outputPath = prefix + "_dynamic.png";
+
+        if(!cv::imwrite(inputPath, imageBgr))
+            throw std::runtime_error("DynEOMT backend failed to write input image: " + inputPath);
+
+        std::ostringstream command;
+        command << "DYN_SLAM_INPUT=" << ShellQuote(inputPath)
+                << " DYN_SLAM_OUTPUT=" << ShellQuote(outputPath)
+                << " DYN_SLAM_WIDTH=" << imageBgr.cols
+                << " DYN_SLAM_HEIGHT=" << imageBgr.rows
+                << " " << mCommand;
+
+        const int status = std::system(command.str().c_str());
+        if(status != 0)
+        {
+            std::remove(inputPath.c_str());
+            throw std::runtime_error("DynEOMT backend command failed: " + mCommand);
+        }
+
+        cv::Mat rawMask = cv::imread(outputPath, cv::IMREAD_GRAYSCALE);
+        std::remove(inputPath.c_str());
+        std::remove(outputPath.c_str());
+        if(rawMask.empty())
+            throw std::runtime_error("DynEOMT backend did not produce a readable mask: " + outputPath);
+
+        if(rawMask.size() != imageBgr.size())
+            cv::resize(rawMask, rawMask, imageBgr.size(), 0.0, 0.0, cv::INTER_NEAREST);
+
+        cv::Mat mask8;
+        if(rawMask.type() == CV_8UC1)
+            mask8 = rawMask;
+        else
+            rawMask.convertTo(mask8, CV_8U);
+
+        if(mConfig.dyneomtOutputIsFeatureMask)
+        {
+            cv::threshold(mask8, featureMask, 0.0, 255.0, cv::THRESH_BINARY);
+            return;
+        }
+
+        cv::Mat dynamicMask;
+        cv::threshold(mask8, dynamicMask,
+                      static_cast<double>(std::max(0.0f, mConfig.dyneomtThreshold)),
+                      255.0, cv::THRESH_BINARY);
+        DynamicToFeatureMask(dynamicMask, mConfig.dilatePixels, featureMask);
+    }
+
+private:
+    SemanticMaskerConfig mConfig;
+    std::string mCommand;
+    std::string mWorkDir;
+    std::atomic<unsigned long long> mCounter;
+};
