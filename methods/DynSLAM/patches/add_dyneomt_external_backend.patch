+std::string ShellQuote(const std::string &value)
+{
+    std::string quoted = "'";
+    for(size_t i = 0; i < value.size(); ++i)
+    {
+        if(value[i] == '\'')
+            quoted += "'\\''";
+        else
+            quoted += value[i];
+    }
+    quoted += "'";
+    return quoted;
+}
